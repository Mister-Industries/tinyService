{
  "name": "@mister-industries/tinyservice",
  "version": "0.0.1",
  "description": "Node.js TypeScript WebSocket service for compiling Arduino projects",
  "type": "module",
  "main": "./dist/service.js",
  "types": "./dist/service.d.ts",
  "exports": {
    ".": {
      "import": "./dist/service.js",
      "types": "./dist/service.d.ts"
    }
  },
  "files": [
    "dist",
    "scripts",
    "binaries",
    "ELECTRON.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "lint-staged": {
    "src/**/*.{js,ts}": [
      "eslint --fix",
      "prettier --write --ignore-unknown"
    ],
    "!(*.js|*.ts)": [
      "prettier --write --ignore-unknown"
    ]
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/service.ts --dts --format esm",
    "test": "vitest run",
    "start": "node dist/service.js",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "download-arduino-cli": "node scripts/download-arduino-cli.js",
    "prepublishOnly": "npm run build && npm run download-arduino-cli"
  },
  "keywords": [
    "arduino",
    "websocket",
    "typescript",
    "compilation"
  ],
  "author": "Ethan Eckhardt",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mister-industries/tinyService.git"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@tinyservice/eslint-config": "*",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "eslint": "^9.0.0",
    "extract-zip": "^2.0.1",
    "pkg": "^5.8.1",
    "tar": "^7.4.3",
    "ts-node-dev": "^2.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.3.2"
  },
  "dependencies": {
    "@mister-industries/shared": "*",
    "express": "^4.18.2",
    "uuid": "^9.0.1",
    "ws": "^8.14.2"
  }
}
