{
  "name": "@tinyservice/tinyservice",
  "version": "0.0.0",
  "description": "Node.js TypeScript WebSocket service for compiling Arduino projects",
  "private": "true",
  "type": "module",
  "main": "./dist/service.js",
  "types": "./dist/service.d.ts",
  "files": [
    "dist"
  ],
  "lint-staged": {
    "*.{js,ts}": [
      "eslint ./src/**/*.{js,ts} --fix",
      "prettier --write --ignore-unknown"
    ],
    "!(*.js|*.ts)": [
      "prettier --write --ignore-unknown"
    ]
  },
  "scripts": {
    "dev": "tsx watch src/service.ts",
    "build": "tsup src/service.ts --dts --format esm",
    "start": "node dist/service.js",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix"
  },
  "keywords": [
    "arduino",
    "websocket",
    "typescript",
    "compilation"
  ],
  "author": "",
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "eslint": "^9.0.0",
    "pkg": "^5.8.1",
    "ts-node-dev": "^2.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.3.2"
  },
  "dependencies": {
    "express": "^4.18.2",
    "uuid": "^9.0.1",
    "ws": "^8.14.2"
  }
}
